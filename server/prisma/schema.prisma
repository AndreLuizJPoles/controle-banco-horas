generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdjustmentType {
  ENTRY
  EXIT
  OTHER
  ABSENT
}

enum DuringDayKind {
  ADD
  SUBTRACT
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  password        String
  role            Role        @default(USER)
  status          UserStatus  @default(PENDING)
  workStartTime   String      @default("08:00")
  workEndTime     String      @default("17:00")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  hourEntries     HourEntry[] @relation("UserEntries")
  approvedEntries HourEntry[] @relation("ApprovedBy")
}

model HourEntry {
  id                     String      @id @default(uuid())
  userId                 String
  user                   User        @relation("UserEntries", fields: [userId], references: [id])
  date                   DateTime    @db.Date
  clockIn                String?
  clockOut               String?
  adjustmentType         AdjustmentType?
  duringDayKind          DuringDayKind?
  duringDayHours         Decimal?    @db.Decimal(10, 2)
  withMedicalCertificate Boolean     @default(false)
  hours                  Decimal     @db.Decimal(10, 2)
  description            String
  status                 EntryStatus @default(PENDING)
  approvedById String?
  approvedBy   User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
