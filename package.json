{
  "name": "controle-banco-horas",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "db:migrate": "node scripts/sync-env.js && npm run db:migrate --workspace=server",
    "db:seed": "node scripts/sync-env.js && npm run db:seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
