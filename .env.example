# Use Session Pooler (IPv4) — Supabase Connect → Direct → Session pooler
# Direct host (db.xxx.supabase.co) often fails on IPv4 networks (Prisma P1001)
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@aws-1-REGION.pooler.supabase.com:5432/postgres
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
NODE_ENV=development
PORT=3000
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
